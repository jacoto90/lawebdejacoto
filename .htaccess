# Security baseline
Options -Indexes
DirectoryIndex index.php

# Small first load, reusable static assets on subsequent visits.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Block hidden files and VCS
<FilesMatch "(^\.|\.git|\.svn|\.hg)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block sensitive config and backup files
<FilesMatch "(composer\.(json|lock)|\.env|\.ini|\.log|\.sql|\.bak|\.old|\.swp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent direct access to internal docs/data text
<FilesMatch "^(infoCv\.txt|inodos\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Basic hardening headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Disable TRACE/TRACK
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Descriptive image filenames; retain existing indexed and bookmarked URLs.
    RewriteRule ^assets/images/portrait(-480)?\.webp$ /assets/images/jose-angel-colmena-desarrollador-web-girona$1.webp [R=301,L]
    RewriteRule ^assets/images/golf(-480)?\.webp$ /assets/images/jose-angel-colmena-golf$1.webp [R=301,L]
    RewriteRule ^assets/images/logistics(-640)?\.webp$ /assets/images/proyecto-logistica-meibit$1.webp [R=301,L]
    RewriteRule ^assets/images/photography(-640)?\.webp$ /assets/images/web-jacoto-fotografia$1.webp [R=301,L]
    RewriteRule ^assets/images/sticnow(-640)?\.webp$ /assets/images/tienda-online-sticnow$1.webp [R=301,L]
    RewriteRule ^assets/images/paso-seguro(-640)?\.webp$ /assets/images/paso-seguro-aviso-peatonal$1.webp [R=301,L]
    RewriteRule ^assets/images/logistica/imagen1\.webp$ /assets/images/logistica/terminal-control-muelle-carga.webp [R=301,L]
    RewriteRule ^assets/images/logistica/imagen2\.webp$ /assets/images/logistica/portal-gestion-muelles.webp [R=301,L]
    RewriteRule ^assets/images/logistica/imagen3\.webp$ /assets/images/logistica/estados-muelles-alarmas.webp [R=301,L]
    RewriteRule ^assets/images/logistica/imagen4\.webp$ /assets/images/logistica/etapas-sesion-muelle-21.webp [R=301,L]
    RewriteRule ^assets/images/logistica/graficos1i2\.webp$ /assets/images/logistica/timeline-operaciones-muelles.webp [R=301,L]
    RewriteRule ^assets/images/logistica/infografico1\.webp$ /assets/images/logistica/informe-tiempos-proceso-17.webp [R=301,L]
    RewriteRule ^assets/images/logistica/infografico2\.webp$ /assets/images/logistica/informe-tiempos-proceso-18.webp [R=301,L]
    RewriteRule ^assets/images/paso-seguro/stop_con_laser_caso_real\.webp$ /assets/images/paso-seguro/aviso-laser-stop-salida-parking.webp [R=301,L]
    RewriteRule ^assets/images/paso-seguro/stop_dispositivo\.webp$ /assets/images/paso-seguro/proyector-senal-stop.webp [R=301,L]
    RewriteRule ^assets/images/paso-seguro/secuencia_([1-6])_pasoseguro\.webp$ /assets/images/paso-seguro/secuencia-aviso-peatonal-$1.webp [R=301,L]

    # Redirect /index.php to clean root URL
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
    RewriteRule .* - [F,L]

    # Internal PHP/config files are include-only and must never be served directly
    RewriteRule ^(app|config|storage|tools|tests)(/|$) - [F,L]

    # Clean routes (/, /sobre-mi, /en/about, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>
